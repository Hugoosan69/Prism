# Supabase — opcionais: há padrão versionado em src/lib/supabase/config.ts.
# A URL e a chave publicável são públicas por definição; quem protege é o RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chat de IA — OBRIGATÓRIA para o chat funcionar. Sem ela a tela abre desligada.
# Nunca versionar: o repositório é público e esta chave é paga.
# Gerada em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Provedor e modelo. Só preencha para trocar: o padrão está em lib/ai/config.ts
# (OpenAI + gpt-4.1-mini). Qualquer endpoint no formato da OpenAI serve.
AI_BASE_URL=
AI_MODEL=

# Busca na web (Tavily, https://tavily.com). Sem ela o modelo simplesmente não
# recebe a ferramenta de busca e trabalha só com Prism e cofre.
TAVILY_API_KEY=

# Cofre do Obsidian, pela API do Google Drive. Sem estas, as ferramentas do
# cofre somem e o chat trabalha só com o Prism.
# O refresh token sai de `node scripts/drive-auth.mjs`, que roda uma vez e
# imprime as linhas prontas para colar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Caminho da pasta do cofre a partir de "My Drive".
# Padrão: Obsidian/SEGUNDO CÉREBRO
GOOGLE_VAULT_FOLDER=
