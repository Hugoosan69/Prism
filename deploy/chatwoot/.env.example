# === Chatwoot — variáveis essenciais ===
# Copie este arquivo para .env e preencha os valores.

# Gerar com: docker run --rm chatwoot/chatwoot:latest bundle exec rake secret
SECRET_KEY_BASE=TROCAR

# URL pública da instância (IP da VPS + porta)
FRONTEND_URL=http://SEU_IP:3000

# Postgres
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=TROCAR

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=TROCAR

# Signup — true só na primeira vez, depois trocar pra false
ENABLE_ACCOUNT_SIGNUP=true

# Locale padrão
DEFAULT_LOCALE=pt_BR

# SMTP (opcional, pra enviar e-mail de notificação e reply)
MAILER_SENDER_EMAIL=Prism <noreply@seudominio.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=

# E-mail inbound (pra receber respostas por e-mail nas conversas)
MAILER_INBOUND_EMAIL_DOMAIN=
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=

# Storage (local por padrão, S3 opcional)
ACTIVE_STORAGE_SERVICE=local

# Log
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
